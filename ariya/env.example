# ========================================
# ARIYA PROTOCOL - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your actual values
# All variables prefixed with VITE_ are exposed to the client-side code

# ========================================
# FIREBASE CONFIGURATION
# ========================================
# Get these values from your Firebase project console:
# https://console.firebase.google.com/project/YOUR_PROJECT/settings/general

VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ========================================
# IMGBB API CONFIGURATION
# ========================================
# Get your API key from: https://api.imgbb.com/
# Used for image uploads in event creation

VITE_IMGBB_API_KEY=your-imgbb-api-key-here

# ========================================
# ENOKI CONFIGURATION
# ========================================
# Get your API key from: https://portal.enoki.mystenlabs.com/
# Used for zkLogin proof generation and transaction execution

VITE_ENOKI_API_KEY=your-enoki-api-key-here

# ========================================
# SUI NETWORK CONFIGURATION
# ========================================
# These are the deployed contract addresses on Sui blockchain
# Update these when deploying to different networks (testnet/mainnet)

# Network: testnet, mainnet, or devnet
VITE_SUI_NETWORK=testnet

# Package ID (the main contract package)
VITE_PACKAGE_ID=0x10d0fc6df7becc7661d35431ae0e0938dd78c429eb2c52eb370c78f2fb775af4

# Registry Object IDs (deployed contract instances)
VITE_EVENT_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_REGISTRATION_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_ATTENDANCE_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_NFT_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_RATING_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_COMMUNITY_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5
VITE_ESCROW_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5

# ========================================
# SUBSCRIPTION CONFIGURATION
# ========================================
# These are the deployed subscription contract addresses

VITE_SUBSCRIPTION_REGISTRY_ID=0x34572e6aa5a2307bac983444b2eed384ad493443b7123aa20b533b23c8d3b817
VITE_SUBSCRIPTION_CONFIG_ID=0x3572153f8ab0fb3620bafed3f30b61c93943e7419e1c5f07c9a746374d3bdae2
VITE_PLATFORM_TREASURY_ID=0x6

# ========================================
# PROFILE REGISTRY
# ========================================
# Profile management contract address

VITE_PROFILE_REGISTRY_ID=0x0bc6254162f07f939bc56dadf590c6be1e1043b68ed7ed9a8f4b455920e0b7a5

# ========================================
# CLOUDINARY CONFIGURATION (Fallback Storage)
# ========================================
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
# Used as fallback when Walrus uploads fail

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# ========================================
# DEVELOPMENT SETTINGS (Optional)
# ========================================
# Uncomment and modify these for development

# VITE_DEBUG_MODE=true
# VITE_LOG_LEVEL=debug 